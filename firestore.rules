rules_version = '2';
// Not deployed yet: Grocify runs in local mode until Firebase is connected.
// Design: the website never talks to the database directly. Only the server (Firebase Admin SDK,
// which bypasses these rules) reads and writes data, so clients are denied everything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
