# --- General ---
NODE_ENV=
PORT=
CLIENT_URL=

# --- Google / Firebase (frontend) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_GOOGLE_CREATOR_ID=

# --- Firebase Admin (backend only) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Payments ---
PAYMENT_PROVIDER=
PAYMENT_GATEWAY_KEY_ID=
PAYMENT_GATEWAY_SECRET=
PAYMENT_WEBHOOK_SECRET=

# --- Logging ---
LOG_LEVEL=
LOG_DIR=
LOG_MAX_FILES=
LOG_MAX_SIZE=

# --- Business rules ---
LOW_STOCK_DEFAULT_LIMIT=

# --- Local development mode (Phase 3) ---
JWT_SECRET=
JWT_EXPIRES_IN=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Orders ---
PAYMENT_TIMEOUT_MINUTES=

# --- Optional ---
DATA_FILE=

# --- Security (see docs/SECURITY_AUDIT_REPORT.md) ---
# Extra browser origins allowed to call the API, comma separated (CLIENT_URL is always allowed)
CORS_ORIGINS=
# Number of reverse proxies in front of the app (defaults to 1 in production, off otherwise)
TRUST_PROXY=
# Set to true to verify the database's TLS certificate
DATABASE_SSL_VERIFY=
# Set to false to stop customers advancing their own delivery (demo aid)
DEMO_DELIVERY_CONTROLS=
# Postgres connection string (keeps data across deployments)
DATABASE_URL=
PAYMENT_GATEWAY_URL=
PAYMENT_GATEWAY_ENV=
